{
  "version": 1,
  "protocol": "ce-routing/v1",
  "operations": ["inspect", "resolve_batch", "finalize_attempt", "patch_source"],
  "native_host_wrapper": {
    "entrypoint": ".opencode/plugins/ce-routing-host.py",
    "operation": "opencode_host",
    "actions": ["resolve_batch", "finalize_attempt"],
    "public_cli_exposed": false,
    "snapshot_publicly_reusable": false
  },
  "attempt_lock_protocol": "ce-routing-attempt-lock/v1",
  "config_replace_protocol": "ce-config-replace/v1",
  "config_replace_recovery": "exclusive-source-lock-old-or-provably-installed-new",
  "snapshot_auth_protocol": "ce-routing-snapshot-auth/v1",
  "snapshot_auth_lifetime_seconds": 604800,
  "snapshot_auth_record_limit": 1024,
  "snapshot_auth_storage": "effective-user-private-state",
  "opencode_adapter_protocol": "ce-opencode-task-adapter/v1",
  "opencode_intent_protocol": "ce-routing-intent/v1",
  "opencode_intent_authority": "native-plugin-in-process-direct-top-level-user-or-command-input-only",
  "opencode_intent_fields": ["role|class", "binding", "source", "provenance"],
  "opencode_handle_binding": ["session", "role", "instance"],
  "opencode_external_comparison_protocol": "ce-opencode-external-handoff/v1",
  "opencode_external_comparison_fields": ["source_revisions", "bindings"],
  "opencode_external_comparison_requirement": "required-when-public-request-host-is-opencode-and-first-candidate-is-external",
  "opencode_tested_sdk_version": "1.18.3",
  "opencode_capability_preflight": ["session.get", "app.agents", "config.get", "model.list", "session.create", "session.prompt", "session.abort", "session.status"],
  "opencode_prompt_reference_capability": "native-resolvePromptParts-not-public-in-sdk-1.18.3",
  "adapter_outcomes": ["ok", "unavailable", "failed"],
  "task_binding_fields": {
    "profile": ["profile", "policy"],
    "direct": ["policy", "candidates"]
  },
  "finalize_request_fields": [
    "snapshot",
    "attempt_lock",
    "attempt",
    "outcome",
    "report",
    "prior_attempts"
  ],
  "attempt_state_fields": ["ordinal", "terminal", "integrated", "phase", "retry_safety"],
  "attempt_phase_values": ["preflight", "dispatched"],
  "attempt_retry_safety_values": ["none", "adapter-isolated", "owner-discarded"],
  "serving_report_fields": ["provider_selected", "model_selected", "variant_selected", "provider_actual", "model_actual", "variant_actual", "effort_actual"],
  "receipt_fields": [
    "snapshot_id",
    "binding_digest",
    "attempt_lock_digest",
    "role",
    "class",
    "profile",
    "source_layer",
    "source_authority",
    "profile_source_layer",
    "profile_source_authority",
    "policy",
    "harness_requested",
    "route_requested",
    "provider_actual",
    "model_requested",
    "model_actual",
    "effort_requested",
    "effort_actual",
    "variant_actual",
    "adapter_outcome",
    "identity_status",
    "attempts",
    "fallback_reason",
    "terminal_status"
  ],
  "error_codes": [
    "REQUEST_INVALID",
    "PROTOCOL_UNSUPPORTED",
    "RUNTIME_UNSUPPORTED",
    "ASSET_INVALID",
    "CONFIG_PATH_INVALID",
    "CONFIG_UNSAFE",
    "CONFIG_IO",
    "CONFIG_TOO_LARGE",
    "CONFIG_CHANGED",
    "CONFIG_RECOVERY_REQUIRED",
    "YAML_SYNTAX",
    "YAML_UNSUPPORTED",
    "YAML_DUPLICATE_KEY",
    "SETTING_INVALID",
    "REFERENCE_UNKNOWN",
    "AUTHORITY_UNTRUSTED",
    "ROLE_UNKNOWN",
    "ROLE_UNCLASSIFIED",
    "CONTEXT_CONFLICT",
    "CONTEXT_STALE",
    "ROUTE_UNAVAILABLE",
    "IDENTITY_REQUIRED",
    "IDENTITY_MISMATCH",
    "ATTEMPT_FAILED",
    "ATTEMPT_LOCK_INVALID",
    "RETRY_UNSAFE",
    "WRITE_CONFLICT",
    "WRITE_UNSAFE",
    "INTERNAL"
  ],
  "exit_codes": {
    "request": 2,
    "config": 3,
    "route": 4,
    "write": 5,
    "internal": 70
  }
}
