{
  "version": 1,
  "protocol": "ce-routing/v1",
  "operations": ["inspect", "resolve_batch", "finalize_attempt", "patch_source"],
  "attempt_lock_protocol": "ce-routing-attempt-lock/v1",
  "config_replace_protocol": "ce-config-replace/v1",
  "config_replace_recovery": "exclusive-source-lock-old-or-provably-installed-new",
  "snapshot_auth_protocol": "ce-routing-snapshot-auth/v1",
  "snapshot_auth_lifetime_seconds": 604800,
  "snapshot_auth_record_limit": 1024,
  "snapshot_auth_storage": "effective-user-private-state",
  "adapter_outcomes": ["ok", "unavailable", "failed"],
  "task_binding_fields": {
    "profile": ["profile", "policy"],
    "direct": ["policy", "candidates"]
  },
  "finalize_request_fields": [
    "snapshot",
    "attempt_lock",
    "attempt",
    "outcome",
    "report",
    "prior_attempts"
  ],
  "receipt_fields": [
    "snapshot_id",
    "binding_digest",
    "attempt_lock_digest",
    "role",
    "class",
    "profile",
    "source_layer",
    "source_authority",
    "profile_source_layer",
    "profile_source_authority",
    "policy",
    "harness_requested",
    "route_requested",
    "model_requested",
    "model_actual",
    "effort_requested",
    "effort_actual",
    "adapter_outcome",
    "identity_status",
    "attempts",
    "fallback_reason",
    "terminal_status"
  ],
  "error_codes": [
    "REQUEST_INVALID",
    "PROTOCOL_UNSUPPORTED",
    "RUNTIME_UNSUPPORTED",
    "ASSET_INVALID",
    "CONFIG_PATH_INVALID",
    "CONFIG_UNSAFE",
    "CONFIG_IO",
    "CONFIG_TOO_LARGE",
    "CONFIG_CHANGED",
    "CONFIG_RECOVERY_REQUIRED",
    "YAML_SYNTAX",
    "YAML_UNSUPPORTED",
    "YAML_DUPLICATE_KEY",
    "SETTING_INVALID",
    "REFERENCE_UNKNOWN",
    "AUTHORITY_UNTRUSTED",
    "ROLE_UNKNOWN",
    "ROLE_UNCLASSIFIED",
    "CONTEXT_CONFLICT",
    "CONTEXT_STALE",
    "ROUTE_UNAVAILABLE",
    "IDENTITY_REQUIRED",
    "IDENTITY_MISMATCH",
    "ATTEMPT_FAILED",
    "ATTEMPT_LOCK_INVALID",
    "RETRY_UNSAFE",
    "WRITE_CONFLICT",
    "WRITE_UNSAFE",
    "INTERNAL"
  ],
  "exit_codes": {
    "request": 2,
    "config": 3,
    "route": 4,
    "write": 5,
    "internal": 70
  }
}
