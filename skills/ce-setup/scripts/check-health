#!/usr/bin/env bash
# Compound Engineering environment health check.
# Reports optional tool capabilities and repo-local config safety in one pass.

set -o pipefail

# =====================================================
#  Optional capability config
# =====================================================
# Format: name|install_cmd|url|capability

deps=(
  "agent-browser|CI=true npm install -g agent-browser --no-audit --no-fund --loglevel=error && agent-browser install|https://github.com/vercel-labs/agent-browser|browser testing, dogfood QA, and visual polish inspection"
  "gh|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q gh|https://cli.github.com|GitHub PR, issue, and review workflows"
  "jq|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q jq|https://jqlang.github.io/jq/|JSON inspection in shell-based workflows"
  "ast-grep|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q ast-grep|https://ast-grep.github.io|syntax-aware structural code search"
  "ffmpeg|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q ffmpeg|https://ffmpeg.org/download.html|media chunking and screenshot extraction for Riffrec analysis"
)

# =====================================================
#  Args
# =====================================================

plugin_version=""
while [ $# -gt 0 ]; do
  case "$1" in
    --version) [ -n "$2" ] && plugin_version="$2" && shift 2 || shift ;;
    *) shift ;;
  esac
done

# =====================================================
#  Helpers
# =====================================================

ok()      { echo "  🟢  $1"; }
warn()    { echo "  🟡  $1"; }
skip()    { echo "  ➖  $1"; }
detail()  { echo "       $1"; }
section() { echo ""; echo " $1"; }

script_dir="${BASH_SOURCE[0]%/*}"
[ "$script_dir" = "${BASH_SOURCE[0]}" ] && script_dir="."
script_dir="$(cd "$script_dir" && pwd)"
routing_script="$script_dir/ce-routing.py"

run_config_inspect() {
  local inspect_cwd="$1"
  CE_HEALTH_INSPECT_CWD="$inspect_cwd" python3 -I -S -c '
import json
import os
import sys

json.dump(
    {
        "protocol": "ce-routing/v1",
        "op": "inspect",
        "cwd": os.environ["CE_HEALTH_INSPECT_CWD"],
    },
    sys.stdout,
    separators=(",", ":"),
)
' | python3 -I -S "$routing_script"
}

format_config_inspection() {
  python3 -I -S -c '
import json
import sys


def compact(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def flag(value):
    return "yes" if value else "no"


def emit_source(label, source):
    path = source.get("path")
    if path is None:
        print("  ➖  {} source: not applicable outside a Git repository".format(label))
        print("       revision={}".format(source.get("revision", "unknown")))
        return
    state = "present" if source.get("exists") else "absent"
    icon = "🟢" if source.get("exists") else "➖"
    print("  {}  {} source: {} ({})".format(icon, label, path, state))
    print(
        "       revision={}; trusted={}; authority_trusted={}; gitignored={}".format(
            source.get("revision", "unknown"),
            flag(source.get("trusted")),
            flag(source.get("authority_trusted")),
            flag(source.get("ignored")),
        )
    )


try:
    body = json.load(sys.stdin)
except (OSError, ValueError):
    print("  🟡  CE settings inspector returned malformed output")
    raise SystemExit(70)

if not isinstance(body, dict) or not body.get("ok"):
    print("  🟡  CE settings inspector did not return a successful inspection")
    raise SystemExit(70)

sources = body.get("sources", {})
global_source = sources.get("global", {})
project_source = sources.get("project", {})
emit_source("Global", global_source)
emit_source("Project", project_source)

settings = body.get("settings", {})
effective = settings.get("effective", {})
provenance = settings.get("provenance", {})
print("       settings.effective:")
for key in sorted(effective):
    value = effective[key]
    source = provenance.get(key, {})
    if key == "routing":
        provenance_text = "source=merged; global_revision={}; project_revision={}".format(
            source.get("global_revision", "unknown"),
            source.get("project_revision", "unknown"),
        )
    else:
        revision = source.get("revision") or "builtin"
        provenance_text = "source={}; revision={}; authority_trusted={}".format(
            source.get("layer", "unknown"),
            revision,
            flag(source.get("authority_trusted")),
        )
    print("       {} = {} [{}]".format(key, compact(value), provenance_text))

authority = settings.get("authority", {})
if authority:
    rendered = ", ".join("{}={}".format(key, authority[key]) for key in sorted(authority))
    print("       effective authority: {}".format(rendered))

routing = effective.get("routing") or {}
profiles = routing.get("profiles") or {}
classes = routing.get("classes") or {}
roles = routing.get("roles") or {}
print(
    "  🟢  Effective routing: {} profile(s), {} class binding(s), {} role binding(s)".format(
        len(profiles), len(classes), len(roles)
    )
)

issues = False
coverage = body.get("role_coverage", {})
registered = coverage.get("registered", 0)
unclassified = coverage.get("unclassified") or []
if unclassified:
    issues = True
    print("  🟡  Dispatch role coverage: {} registered, {} unclassified".format(registered, len(unclassified)))
    for role in unclassified:
        print("       unclassified role: {}".format(role))
else:
    print("  🟢  Dispatch role coverage: {} registered, 0 unclassified".format(registered))

diagnostics = body.get("diagnostics") or []
retired_work = []
retired_order = ("work_engine_target", "work_engine_model")
quote = chr(39)
for diagnostic in diagnostics:
    issues = True
    code = diagnostic.get("code", "CONFIG_DIAGNOSTIC")
    setting = diagnostic.get("setting")
    if code == "RETIRED_SETTING" and setting in retired_order:
        retired_work.append(setting)
        continue
    if code == "RETIRED_SETTING":
        replacement = diagnostic.get("replacement", "a supported setting")
        print(
            "  🟡  Retired config key {}{}{} -- removed; use {}{}{} instead".format(
                quote, setting, quote, quote, replacement, quote
            )
        )
        continue
    message = diagnostic.get("message", "configuration diagnostic")
    suffix = " for {}".format(setting) if setting else ""
    print("  🟡  {}{} [{}]".format(message, suffix, code))

retired_work = [key for key in retired_order if key in retired_work]
if retired_work:
    print(
        "  🟡  retired config key(s) {} detected; migrate routing to work_engine_preferences entries with harness and optional model fields, then remove the retired keys".format(
            ", ".join(retired_work)
        )
    )

mode = effective.get("work_engine_mode")
preferences = effective.get("work_engine_preferences")
preferences = preferences if isinstance(preferences, list) else []
mode_source = provenance.get("work_engine_mode", {})
if mode is None:
    print("  🟢  CE Work implementation engine: native (effective mode is null; built-in behavior applies)")
    if preferences:
        print("       ordered preferences ignored while effective mode is null")
elif mode == "off":
    if mode_source.get("layer") == "builtin" and not project_source.get("exists"):
        detail_text = "no local config"
    elif mode_source.get("layer") == "builtin":
        detail_text = "setting is commented or missing"
    else:
        detail_text = "standing preference is off"
    print("  🟢  CE Work implementation engine: native ({})".format(detail_text))
    if preferences:
        print("       ordered preferences ignored while standing mode is off")
elif not preferences:
    issues = True
    if retired_work:
        detail_text = "{} cannot use retired scalar routing; migrate {} to work_engine_preferences".format(
            mode, ", ".join(retired_work)
        )
    else:
        detail_text = "{} requires work_engine_preferences".format(mode)
    print("  🟡  CE Work implementation engine unavailable: {}".format(detail_text))
else:
    rendered_preferences = []
    for candidate in preferences:
        item = "{}@{}".format(candidate.get("harness"), candidate.get("model") or "default")
        extras = []
        if candidate.get("effort") is not None:
            extras.append("effort={}".format(candidate["effort"]))
        if candidate.get("route") is not None:
            extras.append("route={}".format(candidate["route"]))
        if extras:
            item += " ({})".format(", ".join(extras))
        rendered_preferences.append(item)
    print("  🟢  CE Work implementation engine: {} -> {}".format(mode, ", ".join(rendered_preferences)))

raise SystemExit(10 if issues else 0)
'
}

format_config_error() {
  local scope="$1"
  local resolver_status="$2"
  CE_HEALTH_ERROR_SCOPE="$scope" CE_HEALTH_RESOLVER_STATUS="$resolver_status" python3 -I -S -c '
import json
import os
import sys

scope = os.environ.get("CE_HEALTH_ERROR_SCOPE", "Compound Engineering")
status = os.environ.get("CE_HEALTH_RESOLVER_STATUS", "unknown")
try:
    body = json.load(sys.stdin)
except (OSError, ValueError):
    print("  🟡  {} CE configuration inspection failed (resolver exit {})".format(scope, status))
    print("       The resolver returned no structured diagnostic; no settings were inferred.")
    raise SystemExit(0)

error = body.get("error", {}) if isinstance(body, dict) else {}
code = error.get("code", "INSPECTION_FAILED")
message = error.get("message", "configuration inspection failed")
print("  🟡  {} CE configuration inspection failed [{}]: {}".format(scope, code, message))
for key in ("path", "reason", "setting", "profile", "line", "column", "current_revision"):
    if key in error:
        print("       {}={}".format(key, error[key]))
print("       No effective settings were reported because the source could not be validated.")
'
}

has_brew=$(command -v brew >/dev/null 2>&1 && echo "yes" || echo "no")
in_repo=$(git rev-parse --is-inside-work-tree >/dev/null 2>&1 && echo "yes" || echo "no")

# =====================================================
#  Check optional capabilities
# =====================================================

capability_ok=0
capability_total=0
capability_missing=0
results=()

for entry in "${deps[@]}"; do
  IFS='|' read -r name install_cmd url capability <<< "$entry"
  capability_total=$((capability_total + 1))
  if command -v "$name" >/dev/null 2>&1; then
    capability_ok=$((capability_ok + 1))
    results+=("$name|ok|$install_cmd|$url|$capability")
  else
    capability_missing=$((capability_missing + 1))
    results+=("$name|missing|$install_cmd|$url|$capability")
  fi
done

# =====================================================
#  Effective CE settings inspection
# =====================================================

inspect_cwd=$(pwd -P)
inspect_response=$(run_config_inspect "$inspect_cwd")
inspect_status=$?
inspect_scope="Compound Engineering"

if [ "$inspect_status" -ne 0 ]; then
  if [ "$in_repo" = "yes" ]; then
    global_response=$(run_config_inspect "/")
    global_status=$?
    if [ "$global_status" -ne 0 ]; then
      inspect_scope="Global"
      inspect_response="$global_response"
      inspect_status="$global_status"
    else
      inspect_scope="Project"
    fi
  else
    inspect_scope="Global"
  fi
fi

# =====================================================
#  Project checks (repo only)
# =====================================================

legacy_cfg="skip"
repo_cfg_gitignore="skip"
local_cfg="skip"
example_cfg="skip"
project_issues=0
settings_issues=0

if [ "$in_repo" = "yes" ]; then
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  legacy_cfg="missing"
  [ -f "$repo_root/compound-engineering.local.md" ] && legacy_cfg="present"

  local_cfg="missing"
  if [ -e "$repo_root/.compound-engineering/config.local.yaml" ]; then
    local_cfg="present"
    if git check-ignore -q "$repo_root/.compound-engineering/config.local.yaml" 2>/dev/null; then
      repo_cfg_gitignore="ok"
    else
      repo_cfg_gitignore="missing"
    fi
  fi

  template="$script_dir/../references/config-template.yaml"
  example="$repo_root/.compound-engineering/config.local.example.yaml"
  if [ ! -f "$example" ]; then
    example_cfg="missing"
  elif [ -f "$template" ] && ! diff -q "$template" "$example" >/dev/null 2>&1; then
    example_cfg="outdated"
  else
    example_cfg="ok"
  fi
fi

# =====================================================
#  Output
# =====================================================

echo ""
if [ -n "$plugin_version" ]; then
  ok "Plugin version v${plugin_version}"
fi

section "Optional capabilities  ${capability_ok}/${capability_total}"

for result in "${results[@]}"; do
  IFS='|' read -r name status install_cmd url capability <<< "$result"
  if [ "$status" = "ok" ]; then
    ok "$name -- $capability"
  else
    warn "$name -- unavailable: $capability"
    if [[ "$install_cmd" == *"brew install"* ]] && [ "$has_brew" != "yes" ]; then
      detail "$url"
    else
      detail "$install_cmd"
      detail "$url"
    fi
  fi
done

section "CE settings"
if [ "$inspect_status" -eq 0 ]; then
  inspection_output=$(printf '%s\n' "$inspect_response" | format_config_inspection)
  inspection_format_status=$?
  printf '%s\n' "$inspection_output"
  if [ "$inspection_format_status" -ne 0 ]; then
    settings_issues=1
  fi
else
  printf '%s\n' "$inspect_response" | format_config_error "$inspect_scope" "$inspect_status"
  settings_issues=1
fi

if [ "$in_repo" = "yes" ]; then
  section "Project config"

  if [ "$legacy_cfg" = "present" ]; then
    warn "Obsolete compound-engineering.local.md exists"
    project_issues=$((project_issues + 1))
  else
    ok "No obsolete compound-engineering.local.md"
  fi

  if [ "$local_cfg" = "present" ]; then
    ok ".compound-engineering/config.local.yaml exists"
    if [ "$repo_cfg_gitignore" = "ok" ]; then
      ok "Local config is gitignored"
    else
      warn "Local config is not safely gitignored"
      project_issues=$((project_issues + 1))
    fi
  else
    skip "No local config yet (.compound-engineering/config.local.yaml)"
  fi

  if [ "$example_cfg" = "ok" ]; then
    ok "Example config is current"
  elif [ "$example_cfg" = "missing" ]; then
    warn "Example config missing (.compound-engineering/config.local.example.yaml)"
    project_issues=$((project_issues + 1))
  elif [ "$example_cfg" = "outdated" ]; then
    warn "Example config outdated (new settings available)"
    project_issues=$((project_issues + 1))
  fi
else
  section "Project config"
  skip "Not inside a git repository"
fi

echo ""
if [ "$project_issues" -eq 0 ] && [ "$settings_issues" -eq 0 ] && [ "$in_repo" = "yes" ]; then
  echo " ✅  Project config healthy. Optional capabilities available: ${capability_ok}/${capability_total}"
elif [ "$project_issues" -eq 0 ] && [ "$settings_issues" -eq 0 ]; then
  echo " ✅  CE settings healthy. Optional capabilities available: ${capability_ok}/${capability_total}"
elif [ "$settings_issues" -eq 0 ]; then
  echo " ⚠️   ${project_issues} project issue(s) found. Optional capabilities available: ${capability_ok}/${capability_total}"
elif [ "$project_issues" -eq 0 ]; then
  echo " ⚠️   ${settings_issues} CE settings issue(s) found. Optional capabilities available: ${capability_ok}/${capability_total}"
else
  total_issues=$((project_issues + settings_issues))
  echo " ⚠️   ${total_issues} configuration issue(s) found (${project_issues} project, ${settings_issues} CE settings). Optional capabilities available: ${capability_ok}/${capability_total}"
fi

if [ "$capability_missing" -gt 0 ]; then
  echo "     Missing optional tools do not block setup; install them only for the workflows you use."
fi

echo ""
